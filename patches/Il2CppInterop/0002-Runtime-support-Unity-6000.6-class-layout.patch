From 03dc757e70bb188a42af0cdc088be022f7c9672e Mon Sep 17 00:00:00 2001
From: Andrew Hartwig <andrew.hartwig1@gmail.com>
Date: Fri, 6 Nov 2026 12:47:34 -0500
Subject: [PATCH 2/2] Runtime: support Unity 6000.6 class layout

Unity 6000.6 removes the separate implementedInterfaces array, so class injection and the debug dump read interfaces from interfaceOffsets instead.
---
 .../Injection/ClassInjector.Debug.cs          |   2 +-
 .../Injection/ClassInjector.cs                |   4 +-
 .../VersionSpecific/Class/Class_6000_6.cs     | 208 ++++++++++++++++++
 3 files changed, 212 insertions(+), 2 deletions(-)
 create mode 100644 Il2CppInterop.Runtime/Runtime/VersionSpecific/Class/Class_6000_6.cs

diff --git a/Il2CppInterop.Runtime/Injection/ClassInjector.Debug.cs b/Il2CppInterop.Runtime/Injection/ClassInjector.Debug.cs
index 47f6796..63ff1fc 100644
--- a/Il2CppInterop.Runtime/Injection/ClassInjector.Debug.cs
+++ b/Il2CppInterop.Runtime/Injection/ClassInjector.Debug.cs
@@ -83,7 +83,7 @@ public unsafe partial class ClassInjector
         Logger.Instance.LogDebug(" ImplementedInterfaces ({InterfaceCount}):", classStruct.InterfaceCount);
         for (var i = 0; i < classStruct.InterfaceCount; i++)
         {
-            var @interface = UnityVersionHandler.Wrap(classStruct.ImplementedInterfaces[i]);
+            var @interface = UnityVersionHandler.Wrap(classStruct.ImplementedInterfaces != null ? classStruct.ImplementedInterfaces[i] : classStruct.InterfaceOffsets[i].interfaceType);
 
             Logger.Instance.LogDebug("  [{I}] {Name}", i, Marshal.PtrToStringUTF8(@interface.Name));
         }
diff --git a/Il2CppInterop.Runtime/Injection/ClassInjector.cs b/Il2CppInterop.Runtime/Injection/ClassInjector.cs
index 473c718..122b2ff 100644
--- a/Il2CppInterop.Runtime/Injection/ClassInjector.cs
+++ b/Il2CppInterop.Runtime/Injection/ClassInjector.cs
@@ -488,7 +488,9 @@ public static unsafe partial class ClassInjector
         classPointer.InterfaceCount = (ushort)interfaceCount;
         classPointer.ImplementedInterfaces = (Il2CppClass**)Marshal.AllocHGlobal(interfaceCount * IntPtr.Size);
         for (var i = 0; i < baseClassPointer.InterfaceCount; i++)
-            classPointer.ImplementedInterfaces[i] = baseClassPointer.ImplementedInterfaces[i];
+            classPointer.ImplementedInterfaces[i] = baseClassPointer.ImplementedInterfaces != null
+                ? baseClassPointer.ImplementedInterfaces[i]
+                : baseClassPointer.InterfaceOffsets[i].interfaceType; // Unity 6000.6+ has no separate array
         for (int i = baseClassPointer.InterfaceCount; i < interfaceCount; i++)
             classPointer.ImplementedInterfaces[i] = interfaces[i - baseClassPointer.InterfaceCount].ClassPointer;
 
diff --git a/Il2CppInterop.Runtime/Runtime/VersionSpecific/Class/Class_6000_6.cs b/Il2CppInterop.Runtime/Runtime/VersionSpecific/Class/Class_6000_6.cs
new file mode 100644
index 0000000..e48a4eb
--- /dev/null
+++ b/Il2CppInterop.Runtime/Runtime/VersionSpecific/Class/Class_6000_6.cs
@@ -0,0 +1,208 @@
+using System;
+using System.Runtime.InteropServices;
+using Il2CppInterop.Runtime.Runtime.VersionSpecific.Type;
+namespace Il2CppInterop.Runtime.Runtime.VersionSpecific.Class
+{
+    // Unity 6000.6 (IL2CPP metadata v108) drops implementedInterfaces: the interfaces are read from interfaceOffsets.
+    // Every field after it moved up 8 bytes compared to 6000.5, so the vtable starts at 304. Measured at runtime on a
+    // 6000.6.0f1 GameAssembly.dll by matching the il2cpp API against raw class memory for System.Object, System.String,
+    // System.Int32, System.DayOfWeek, IEnumerator, List<T>, AppDomain and UnityEngine.MonoBehaviour.
+    [ApplicableToUnityVersionsSince("6000.6.0")]
+    public unsafe class NativeClassStructHandler_6000_6 : INativeClassStructHandler
+    {
+        public int Size() => sizeof(Il2CppClass_6000_6);
+        public INativeClassStruct CreateNewStruct(int vTableSlots)
+        {
+            IntPtr ptr = Marshal.AllocHGlobal(Size() + sizeof(VirtualInvokeData) * vTableSlots);
+            Il2CppClass_6000_6* _ = (Il2CppClass_6000_6*)ptr;
+            *_ = default;
+            return new NativeStructWrapper(ptr);
+        }
+        public INativeClassStruct Wrap(Il2CppClass* ptr)
+        {
+            if (ptr == null) return null;
+            return new NativeStructWrapper((IntPtr)ptr);
+        }
+        internal unsafe struct Il2CppClass_6000_6
+        {
+            public Il2CppImage* image;                                  // 0
+            public void* gc_desc;                                       // 8
+            public byte* name;                                          // 16
+            public byte* namespaze;                                     // 24
+            public NativeTypeStructHandler_27_0.Il2CppType_27_0 byval_arg; // 32
+            public NativeTypeStructHandler_27_0.Il2CppType_27_0 this_arg;  // 48
+            public Il2CppClass* element_class;                          // 64
+            public Il2CppClass* castClass;                              // 72
+            public Il2CppClass* declaringType;                          // 80
+            public Il2CppClass* parent;                                 // 88
+            public void* generic_class;                                 // 96
+            public Il2CppMetadataTypeHandle typeMetadataHandle;         // 104
+            public void* interopData;                                   // 112
+            public Il2CppClass* klass;                                  // 120
+            public Il2CppFieldInfo* fields;                             // 128
+            public Il2CppMethodInfo** methods;                          // 136
+            public Il2CppRuntimeInterfaceOffsetPair* interfaceOffsets;  // 144
+            public void* static_fields;                                 // 152
+            public void* rgctx_data;                                    // 160
+            public Il2CppClass** typeHierarchy;                         // 168
+            public Il2CppEventInfo* events;                             // 176 (lazily created)
+            public Il2CppPropertyInfo* properties;                      // 184 (lazily created)
+            public Il2CppClass** nestedTypes;                           // 192 (lazily created)
+            public void* unity_user_data;                               // 200
+            public Il2CppGCHandle initializationExceptionGCHandle;      // 208
+            public uint cctor_started;                                  // 216
+            public uint cctor_finished_or_no_cctor;                     // 220
+            public IntPtr cctor_thread;                                 // 224
+            public void* genericContainerHandle;                        // 232
+            public uint instance_size;                                  // 240
+            public uint stack_slot_size;                                // 244
+            public uint actualSize;                                     // 248
+            public uint element_size;                                   // 252
+            public int native_size;                                     // 256
+            public uint static_fields_size;                             // 260
+            public uint thread_static_fields_size;                      // 264
+            public int thread_static_fields_offset;                     // 268
+            public uint flags;                                          // 272
+            public uint token;                                          // 276
+            public ushort method_count;                                 // 280
+            public ushort property_count;                               // 282
+            public ushort field_count;                                  // 284
+            public ushort event_count;                                  // 286
+            public ushort nested_type_count;                            // 288
+            public ushort vtable_count;                                 // 290
+            public ushort interfaces_count;                             // 292
+            public ushort interface_offsets_count;                      // 294
+            public byte typeHierarchyDepth;                             // 296
+            public byte genericRecursionDepth;                          // 297
+            public byte rank;                                           // 298
+            public byte minimumAlignment;                               // 299
+            public byte packingSize;                                    // 300
+            public byte _bitfield0;                                     // 301 (initialized group)
+            public byte _bitfield1;                                     // 302
+            public byte _bitfield2;                                     // 303 (is_byref_like, has_inline_array)
+            internal enum Bitfield0 : byte
+            {
+                BIT_initialized_and_no_error = 0,
+                initialized_and_no_error = (1 << BIT_initialized_and_no_error),
+                BIT_initialized = 1,
+                initialized = (1 << BIT_initialized),
+                BIT_enumtype = 2,
+                enumtype = (1 << BIT_enumtype),
+                BIT_nullabletype = 3,
+                nullabletype = (1 << BIT_nullabletype),
+                BIT_is_generic = 4,
+                is_generic = (1 << BIT_is_generic),
+                BIT_has_references = 5,
+                has_references = (1 << BIT_has_references),
+                BIT_init_pending = 6,
+                init_pending = (1 << BIT_init_pending),
+                BIT_size_init_pending = 7,
+                size_init_pending = (1 << BIT_size_init_pending),
+            }
+
+            internal enum Bitfield1 : byte
+            {
+                BIT_size_inited = 0,
+                size_inited = (1 << BIT_size_inited),
+                BIT_has_finalize = 1,
+                has_finalize = (1 << BIT_has_finalize),
+                BIT_has_cctor = 2,
+                has_cctor = (1 << BIT_has_cctor),
+                BIT_is_blittable = 3,
+                is_blittable = (1 << BIT_is_blittable),
+                BIT_is_import_or_windows_runtime = 4,
+                is_import_or_windows_runtime = (1 << BIT_is_import_or_windows_runtime),
+                BIT_is_vtable_initialized = 5,
+                is_vtable_initialized = (1 << BIT_is_vtable_initialized),
+                BIT_is_byref_like = 6,
+                is_byref_like = (1 << BIT_is_byref_like),
+            }
+
+        }
+
+        internal class NativeStructWrapper : INativeClassStruct
+        {
+            public NativeStructWrapper(IntPtr ptr) => Pointer = ptr;
+            private static int _bitfield0offset = Marshal.OffsetOf<Il2CppClass_6000_6>(nameof(Il2CppClass_6000_6._bitfield0)).ToInt32();
+            private static int _bitfield1offset = Marshal.OffsetOf<Il2CppClass_6000_6>(nameof(Il2CppClass_6000_6._bitfield1)).ToInt32();
+            public IntPtr Pointer { get; }
+            private Il2CppClass_6000_6* _ => (Il2CppClass_6000_6*)Pointer;
+            public IntPtr VTable => IntPtr.Add(Pointer, sizeof(Il2CppClass_6000_6));
+            public Il2CppClass* ClassPointer => (Il2CppClass*)Pointer;
+            public INativeTypeStruct ByValArg => UnityVersionHandler.Wrap((Il2CppTypeStruct*)&_->byval_arg);
+            public INativeTypeStruct ThisArg => UnityVersionHandler.Wrap((Il2CppTypeStruct*)&_->this_arg);
+            public ref uint InstanceSize => ref _->instance_size;
+            public ref ushort VtableCount => ref _->vtable_count;
+            public ref ushort InterfaceCount => ref _->interfaces_count;
+            public ref ushort InterfaceOffsetsCount => ref _->interface_offsets_count;
+            public ref byte TypeHierarchyDepth => ref _->typeHierarchyDepth;
+            public ref int NativeSize => ref _->native_size;
+            public ref uint ActualSize => ref _->actualSize;
+            public ref ushort MethodCount => ref _->method_count;
+            public ref ushort FieldCount => ref _->field_count;
+            public ref Il2CppClassAttributes Flags => ref *(Il2CppClassAttributes*)&_->flags;
+            public ref IntPtr Name => ref *(IntPtr*)&_->name;
+            public ref IntPtr Namespace => ref *(IntPtr*)&_->namespaze;
+            public ref Il2CppImage* Image => ref _->image;
+            public ref Il2CppClass* Parent => ref _->parent;
+            public ref Il2CppClass* ElementClass => ref _->element_class;
+            public ref Il2CppClass* CastClass => ref _->castClass;
+            public ref Il2CppClass* DeclaringType => ref _->declaringType;
+            public ref Il2CppClass* Class => ref _->klass;
+            public ref Il2CppFieldInfo* Fields => ref _->fields;
+            public ref Il2CppMethodInfo** Methods => ref _->methods;
+            // No native field on this version: ClassInjector fills it, the runtime reads InterfaceOffsets.
+            private Il2CppClass** _implementedInterfaces;
+            public ref Il2CppClass** ImplementedInterfaces => ref _implementedInterfaces;
+            public ref Il2CppRuntimeInterfaceOffsetPair* InterfaceOffsets => ref _->interfaceOffsets;
+            public ref Il2CppClass** TypeHierarchy => ref _->typeHierarchy;
+            public bool ValueType
+            {
+                get => ByValArg.ValueType && ThisArg.ValueType;
+                set { }
+            }
+            public bool Initialized
+            {
+                get => this.CheckBit(_bitfield0offset, (int)Il2CppClass_6000_6.Bitfield0.BIT_initialized);
+                set => this.SetBit(_bitfield0offset, (int)Il2CppClass_6000_6.Bitfield0.BIT_initialized, value);
+            }
+            public bool EnumType
+            {
+                get => this.CheckBit(_bitfield0offset, (int)Il2CppClass_6000_6.Bitfield0.BIT_enumtype);
+                set => this.SetBit(_bitfield0offset, (int)Il2CppClass_6000_6.Bitfield0.BIT_enumtype, value);
+            }
+            public bool IsGeneric
+            {
+                get => this.CheckBit(_bitfield0offset, (int)Il2CppClass_6000_6.Bitfield0.BIT_is_generic);
+                set => this.SetBit(_bitfield0offset, (int)Il2CppClass_6000_6.Bitfield0.BIT_is_generic, value);
+            }
+            public bool HasReferences
+            {
+                get => this.CheckBit(_bitfield0offset, (int)Il2CppClass_6000_6.Bitfield0.BIT_has_references);
+                set => this.SetBit(_bitfield0offset, (int)Il2CppClass_6000_6.Bitfield0.BIT_has_references, value);
+            }
+            public bool SizeInited
+            {
+                get => this.CheckBit(_bitfield1offset, (int)Il2CppClass_6000_6.Bitfield1.BIT_size_inited);
+                set => this.SetBit(_bitfield1offset, (int)Il2CppClass_6000_6.Bitfield1.BIT_size_inited, value);
+            }
+            public bool HasFinalize
+            {
+                get => this.CheckBit(_bitfield1offset, (int)Il2CppClass_6000_6.Bitfield1.BIT_has_finalize);
+                set => this.SetBit(_bitfield1offset, (int)Il2CppClass_6000_6.Bitfield1.BIT_has_finalize, value);
+            }
+            public bool IsVtableInitialized
+            {
+                get => this.CheckBit(_bitfield1offset, (int)Il2CppClass_6000_6.Bitfield1.BIT_is_vtable_initialized);
+                set => this.SetBit(_bitfield1offset, (int)Il2CppClass_6000_6.Bitfield1.BIT_is_vtable_initialized, value);
+            }
+            public bool InitializedAndNoError
+            {
+                get => this.CheckBit(_bitfield0offset, (int)Il2CppClass_6000_6.Bitfield0.BIT_initialized_and_no_error);
+                set => this.SetBit(_bitfield0offset, (int)Il2CppClass_6000_6.Bitfield0.BIT_initialized_and_no_error, value);
+            }
+        }
+
+    }
+
+}
-- 
